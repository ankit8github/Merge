FROM python:3.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv/merge/backend
COPY backend/requirements.lock ./requirements.lock
RUN pip install --no-cache-dir -r requirements.lock
COPY backend/app ./app
COPY backend/alembic/versions ./alembic/versions
COPY backend/production_alembic ./production_alembic
COPY backend/release_support/__init__.py backend/release_support/migrations.py backend/release_support/targets.py backend/release_support/evidence.py ./release_support/
USER 10001:10001
EXPOSE 8000
CMD ["python", "-m", "app.production.serve"]
