{
  "admin": {
    "disabled": true
  },
  "logging": {
    "logs": {
      "default": {
        "exclude": [
          "http.log.access",
          "http.log.error"
        ]
      }
    }
  },
  "apps": {
    "http": {
      "grace_period": "25s",
      "servers": {
        "railway": {
          "listen": [
            ":8080"
          ],
          "automatic_https": {
            "disable": true
          },
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "healthcheck.railway.app"
                  ],
                  "method": [
                    "GET",
                    "HEAD"
                  ],
                  "path": [
                    "/ready"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "127.0.0.1:8000"
                    }
                  ],
                  "transport": {
                    "protocol": "http",
                    "response_header_timeout": "20s"
                  }
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "deployment.invalid"
                  ],
                  "header": {
                    "X-Forwarded-Proto": [
                      "https"
                    ],
                    "X-Real-IP": [
                      "*"
                    ]
                  }
                }
              ],
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "handler": "vars",
                          "railway_client_ip": "{http.request.header.X-Real-IP}"
                        },
                        {
                          "handler": "headers",
                          "response": {
                            "set": {
                              "X-Content-Type-Options": [
                                "nosniff"
                              ],
                              "Referrer-Policy": [
                                "no-referrer"
                              ],
                              "X-Frame-Options": [
                                "DENY"
                              ],
                              "Strict-Transport-Security": [
                                "max-age=31536000"
                              ],
                              "Content-Security-Policy": [
                                "default-src 'self'; connect-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
                              ],
                              "Permissions-Policy": [
                                "camera=(), microphone=(), geolocation=()"
                              ]
                            }
                          }
                        }
                      ]
                    },
                    {
                      "match": [
                        {
                          "path": [
                            "/ready",
                            "/docs",
                            "/docs/*",
                            "/redoc",
                            "/openapi.json"
                          ]
                        }
                      ],
                      "handle": [
                        {
                          "handler": "static_response",
                          "status_code": 404
                        }
                      ],
                      "terminal": true
                    },
                    {
                      "match": [
                        {
                          "path": [
                            "/auth",
                            "/auth/*",
                            "/api",
                            "/api/*",
                            "/health"
                          ]
                        }
                      ],
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "upstreams": [
                            {
                              "dial": "127.0.0.1:8000"
                            }
                          ],
                          "flush_interval": -1,
                          "stream_timeout": "75s",
                          "headers": {
                            "request": {
                              "delete": [
                                "Forwarded",
                                "X-Real-IP",
                                "X-Forwarded-Host",
                                "X-Forwarded-Port"
                              ],
                              "set": {
                                "X-Forwarded-For": [
                                  "{http.vars.railway_client_ip}"
                                ],
                                "X-Forwarded-Proto": [
                                  "https"
                                ]
                              }
                            }
                          },
                          "transport": {
                            "protocol": "http",
                            "response_header_timeout": "20s"
                          }
                        }
                      ],
                      "terminal": true
                    },
                    {
                      "match": [
                        {
                          "path": [
                            "/assets/*"
                          ],
                          "method": [
                            "GET",
                            "HEAD"
                          ]
                        }
                      ],
                      "handle": [
                        {
                          "handler": "headers",
                          "response": {
                            "set": {
                              "Cache-Control": [
                                "public, max-age=31536000, immutable"
                              ]
                            }
                          }
                        },
                        {
                          "handler": "file_server",
                          "root": "/srv/merge/web"
                        }
                      ],
                      "terminal": true
                    },
                    {
                      "match": [
                        {
                          "method": [
                            "GET",
                            "HEAD"
                          ],
                          "file": {
                            "root": "/srv/merge/web",
                            "try_files": [
                              "{http.request.uri.path}",
                              "/index.html"
                            ]
                          }
                        }
                      ],
                      "handle": [
                        {
                          "handler": "rewrite",
                          "uri": "{http.matchers.file.relative}"
                        },
                        {
                          "handler": "headers",
                          "response": {
                            "set": {
                              "Cache-Control": [
                                "no-cache"
                              ]
                            }
                          }
                        },
                        {
                          "handler": "file_server",
                          "root": "/srv/merge/web"
                        }
                      ],
                      "terminal": true
                    },
                    {
                      "handle": [
                        {
                          "handler": "static_response",
                          "status_code": 405
                        }
                      ],
                      "terminal": true
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 404
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    }
  }
}
